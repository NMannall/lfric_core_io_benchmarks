#!/bin/bash

export PATH=$BASE_DIR/XIOS3/bin:$PATH
export LD_LIBRARY_PATH=$BASE_DIR/XIOS3/lib:$LD_LIBRARY_PATH
export CPATH=$BASE_DIR/XIOS3/inc:$CPATH

export FFLAGS="-I$BASE_DIR/XIOS3/inc $FFLAGS"
export LDFLAGS="-L$BASE_DIR/XIOS3/lib $LDFLAGS"

export XIOS_EXE=$XIOS3_EXE
export IO_DEMO_EXE=$IO_DEMO_XIOS3_EXE
