#!/bin/bash

export PATH=$BASE_DIR/XIOS2/bin:$PATH
export LD_LIBRARY_PATH=$BASE_DIR/XIOS2/lib:$LD_LIBRARY_PATH
export CPATH=$BASE_DIR/XIOS2/inc:$CPATH

export FFLAGS="-I$BASE_DIR/XIOS2/inc $FFLAGS"
export LDFLAGS="-L$BASE_DIR/XIOS2/lib $LDFLAGS"

export XIOS_EXE=$XIOS2_EXE
export IO_DEMO_EXE=$IO_DEMO_XIOS2_EXE
